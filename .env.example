# MongoDB
MONGODB_URI=

# Cloudinary (cloud name is not secret - next-cloudinary's widget reads it client-side)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin auth (single hardcoded admin - see docs/plans for rationale)
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Seal password for iron-session (any long random string, e.g. `openssl rand -hex 32`)
SESSION_SEAL_PASSWORD=

# Public site URL, used for sitemap.xml/robots.txt absolute URLs and canonical fallbacks.
# Defaults to http://localhost:3000 in dev if unset.
NEXT_PUBLIC_SITE_URL=
